public class Note {
    private double wert;
    private String fach;

    // Konstruktor
    public Note(double wert, String fach) {
        // Hier könnte man Validierung einfügen, z.B. ob die Note zwischen 1.0 und 6.0 liegt
        this.wert = wert;
        this.fach = fach;
    }

    // Getter-Methode für den Notenwert, benötigt für die Durchschnittsberechnung
    public double getWert() {
        return wert;
    }

    // Optional: Getter für das Fach
    public String getFach() {
        return fach;
    }
}
